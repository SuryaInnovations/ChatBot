# ==============================================================================
# SPARK-AI Streamlit Configuration & Secrets Template
# Copy this file to .streamlit/secrets.toml and fill in your actual credentials.
# NEVER commit .streamlit/secrets.toml to version control.
# ==============================================================================

[auth]
# The callback URI configured in your Google Cloud Console OAuth 2.0 Client ID:
redirect_uri = "http://localhost:8501/oauth2callback"

# A secure random secret string used to encrypt session identity cookies:
cookie_secret = "replace-with-a-random-32-byte-secret-string"

# Your Google OAuth 2.0 Client ID:
client_id = "your-google-client-id.apps.googleusercontent.com"

# Your Google OAuth 2.0 Client Secret:
client_secret = "your-google-client-secret"

# OpenID Connect Discovery metadata endpoint for Google:
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

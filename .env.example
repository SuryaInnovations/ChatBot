# All-in-One AI Assistant Production Configuration

# ==========================================
# 1. AI PROVIDER API KEYS (Single or Multi-Key Pool)
# ==========================================
# Supports single key or comma-separated keys for automatic key rotation:
GEMINI_API_KEY=AIza_your_gemini_api_key_here
GEMINI_API_KEYS=AIza_key1,AIza_key2,AIza_key3

GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEYS=gsk_key1,gsk_key2

OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_API_KEYS=sk-proj-key1,sk-proj-key2

# Local LLM Endpoint (Optional, development / emergency fallback only)
OLLAMA_BASE_URL=http://localhost:11434/v1

# ==========================================
# 2. PERSISTENCE & CACHING (600+ Concurrent Users)
# ==========================================
# PostgreSQL Database URL with asyncpg driver:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/chatbot_db
# For SQLite local development: sqlite+aiosqlite:///./chatbot.db

DB_POOL_SIZE=25
DB_MAX_OVERFLOW=35
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Cache, Rate Limiter & Circuit Breaker:
REDIS_URL=redis://localhost:6379/0

# Optional Stateless FastAPI Backend URL (Streamlit -> FastAPI):
FASTAPI_BACKEND_URL=http://localhost:8000

# ==========================================
# 3. MODELS & ROUTING DEFAULTS
# ==========================================
LLM_PROVIDER=auto
LLM_FALLBACK_PROVIDERS=gemini,groq,openai,ollama

GEMINI_MODEL=gemini-flash-lite-latest
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
OLLAMA_MODEL=llama3.2

# Timeouts & Concurrency Bulkheads
LLM_TIMEOUT_SECONDS=8.0
SANDBOX_TIMEOUT_SECONDS=6.0
MAX_UPLOAD_SIZE_MB=25
